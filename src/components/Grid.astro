---
interface Props {
	variant?: 'offset' | 'small';
}

const { variant } = Astro.props;
---

<ul
	class:list={[
		'grid w-full auto-rows-[1fr] lg:grid-cols-[1fr]',
		variant !== 'small' && 'gap-[2em]',
		// Two columns; a lone last item spans both. From lg: a centered, wrapping row of 20rem cards.
		variant === 'small' &&
			'grid-cols-[1fr_1fr] gap-6 lg:flex lg:flex-wrap lg:justify-center lg:gap-8 lg:[&>*]:basis-[20rem] [&>:last-child:nth-child(odd)]:col-[1/3]',
		// From lg: the first item in each row is shifted down for a staggered effect. A lone last item goes in the second column, unshifted.
		variant === 'offset' &&
			'lg:[--row-offset:7.5rem] lg:pb-(--row-offset) lg:[&>:nth-child(odd)]:[transform:translateY(var(--row-offset))] lg:[&>:last-child:nth-child(odd)]:col-[2/3] lg:[&>:last-child:nth-child(odd)]:[transform:none]',
	]}
>
	<slot />
</ul>
