---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const sorted = posts.sort(
		(a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf()
	);

	return sorted.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			prevPost: sorted[index - 1] ?? null,
			nextPost: sorted[index + 1] ?? null,
		},
	}));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

const firstImageMatch = post.body?.match(/!\[.*?\]\(([^)]+)\)/);
const socialImage = firstImageMatch ? firstImageMatch[1] : undefined;

const readingTime = getReadingTime(post.body ?? '');
---

<BaseLayout title={`${post.data.title} | F Cary Snyder`} description={post.data.description} image={socialImage}>
	<main class="wrapper post-layout flex flex-col lg:grid lg:grid-cols-[1fr_var(--reader-width,60%)_1fr]">
		<article class="w-full lg:col-2" data-reader-enabled>
			<PageHeader
				title={post.data.title}
				description={post.data.description}
				date={post.data.publishDate}
				readingTime={readingTime}
				backHref="/writing/"
			/>

			<div class="post-content prose mt-12">
				<Content />
			</div>

			<footer class="post-footer mt-16">
				{post.data.tags && post.data.tags.length > 0 && (
					<div class="post-meta t-meta flex flex-col gap-2 border-t border-t-gray-800 pt-6">
						<div class="meta-row flex justify-between gap-4">
							<span class="meta-label min-w-16 text-gray-400 uppercase">Tags</span>
							<span class="meta-value text-gray-200">{post.data.tags.join(', ')}</span>
						</div>
					</div>
				)}

				<nav class="post-nav mt-8 flex justify-between border-t border-t-gray-800 py-6">
					<div class="nav-prev flex">
						{prevPost && (
							<a href={`/writing/${prevPost.id}/`} class="t-small-link t-link">&larr; Previous</a>
						)}
					</div>
					<div class="nav-next ml-auto flex">
						{nextPost && (
							<a href={`/writing/${nextPost.id}/`} class="t-small-link t-link">Next &rarr;</a>
						)}
					</div>
				</nav>
			</footer>
		</article>
	</main>
</BaseLayout>

<style>
	/* Why not Tailwind: react-tweet's stylesheet is unlayered and sets the embed's margin on its own
	   root (margin: var(--tweet-container-margin), 1.5rem 0). Unlayered CSS beats every layer, so a
	   utility on the wrapper loses whatever its specificity. This rule is unlayered too and more
	   specific, so it centers the 550px embed in the column with the 2rem gap prose blocks use. */
	.post-content :global(.react-tweet-theme) {
		margin: 2rem auto;
		/* 600 is the heaviest weight on the site; react-tweet uses 700 */
		--tweet-actions-font-weight: 600;
		--tweet-replies-font-weight: 600;
	}

	/* The rest of react-tweet's 700s are hard-coded on its CSS-module classes (author name,
	   Follow, quoted author, video link), which Vite names _<class>_<hash>. */
	.post-content :global(.react-tweet-theme :is([class*='_authorLinkText_'], [class*='_follow_'], [class*='_authorText_'], [class*='_anchor_'])) {
		font-weight: 600;
	}
</style>
