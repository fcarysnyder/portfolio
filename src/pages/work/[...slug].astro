---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GatedContent from '../../components/work/GatedContent.tsx';
import CaseStudyCarousel from '../../components/work/CaseStudyCarousel.tsx';
import PageHeader from '../../components/PageHeader.astro';

export async function getStaticPaths() {
  const all = await getCollection('work');
  return all
    .filter((entry) => entry.data.gated === true)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const lockedDataUrl = `/data/${entry.id}.locked.json`;

const screenshotsBySlug: Record<string, { src: string; alt: string }[]> = {
  'synthetic-readings': [
    { src: '/assets/synthetic-readings/facility-performance.png', alt: 'Facility performance dashboard' },
    { src: '/assets/synthetic-readings/demand-events-table.png', alt: 'Demand events table' },
    { src: '/assets/synthetic-readings/TOU-demand-event-feb.png', alt: 'TOU demand event - February' },
    { src: '/assets/synthetic-readings/cp-events-table.png', alt: 'CP events table' },
    { src: '/assets/synthetic-readings/cp-capacity-event-jan.png', alt: 'CP capacity event - January' },
    { src: '/assets/synthetic-readings/CP-transmission-event-mar.png', alt: 'CP transmission event - March' },
    { src: '/assets/synthetic-readings/TOU-demand-event-mar.png', alt: 'TOU demand event - March' },
  ],
};
const screenshots = screenshotsBySlug[entry.id] ?? [];

const metaBySlug: Record<string, { role: string; collaborators: string; product: string }> = {
  'synthetic-readings': {
    role: 'Lead Product Designer',
    collaborators: 'Product, Engineering, Applied Science, Prod. Success',
    product: 'ATLAS industrial control platform',
  },
  'omniscience-commanding': {
    role: 'Lead Product Designer',
    collaborators: 'Product, Engineering, Space Operations',
    product: 'Omniscience UI (C3 platform)',
  },
};
const meta = metaBySlug[entry.id] ?? { role: 'Lead Product Designer', collaborators: '', product: '' };
---

<BaseLayout
  title={`${entry.data.title} | F Cary Snyder`}
  description={entry.data.description}
  image={entry.data.img}
>
  <main class="wrapper post-layout flex flex-col lg:grid lg:grid-cols-[1fr_60%_1fr]">
    <article class="w-full lg:col-2" data-reader-enabled>
      <PageHeader
        title={entry.data.title}
        description={entry.data.description}
        date={entry.data.publishDate}
        backHref="/"
      />

      {screenshots.length > 0 && (
        <CaseStudyCarousel images={screenshots} client:load />
      )}

      <div class="post-meta-top t-meta mt-8 flex flex-col gap-2 border-y border-y-gray-800 py-6">
        <div class="meta-row flex justify-between gap-8">
          <span class="meta-label min-w-24 shrink-0 text-gray-400 uppercase">Role</span>
          <span class="meta-value text-gray-200">{meta.role}</span>
        </div>
        <div class="meta-row flex justify-between gap-8">
          <span class="meta-label min-w-24 shrink-0 text-gray-400 uppercase">Collaborators</span>
          <span class="meta-value text-gray-200">{meta.collaborators}</span>
        </div>
        <div class="meta-row flex justify-between gap-8">
          <span class="meta-label min-w-24 shrink-0 text-gray-400 uppercase">Product</span>
          <span class="meta-value text-gray-200">{meta.product}</span>
        </div>
      </div>

      <div class="post-content mt-12 [&_.gated-placeholder]:rounded-xl [&_.gated-placeholder]:border [&_.gated-placeholder]:border-gray-800 [&_.gated-placeholder]:bg-(image:--gradient-subtle) [&_.gated-placeholder]:p-8 [&_.gated-placeholder]:text-center [&_.gated-placeholder]:text-gray-300">
        {entry.data.gated ? (
          <GatedContent lockedDataUrl={lockedDataUrl} caseStudyTitle={entry.data.title} client:load />
        ) : null}
      </div>

      <footer class="post-footer mt-16">
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="post-meta t-meta flex flex-col gap-2 border-t border-t-gray-800 pt-6">
            <div class="meta-row flex justify-between gap-4">
              <span class="meta-label min-w-24 shrink-0 text-gray-400 uppercase">Tags</span>
              <span class="meta-value text-gray-200">{entry.data.tags.join(', ')}</span>
            </div>
          </div>
        )}
      </footer>
    </article>
  </main>
</BaseLayout>
