---
import { Sun, MoonStar } from '@lucide/astro';
---

<theme-toggle>
	<button class="group icon-control">
		<span class="sr-only">Dark theme</span>
		<span class="relative z-1 flex size-8 p-2 text-(length:--text-base) motion-safe:[transition:transform_var(--theme-transition),color_var(--theme-transition)] text-on-accent dark:text-accent-text dark:group-aria-[pressed=false]:text-on-accent before:absolute before:inset-0 before:-z-1 before:rounded-[999rem] before:bg-accent-fill before:content-[''] before:[transition:background-color_var(--theme-transition),transform_var(--theme-transition)] motion-safe:before:[transition:transform_var(--theme-transition),color_var(--theme-transition)] group-hover:before:bg-accent-fill-hover dark:before:[transform:translateX(100%)] forced-colors:before:bg-[SelectedItem]"><Sun size="1em" /></span>
		<span class="relative z-1 flex size-8 p-2 text-(length:--text-base) motion-safe:[transition:transform_var(--theme-transition),color_var(--theme-transition)] text-accent-text dark:text-on-accent"><MoonStar size="1em" /></span>
	</button>
</theme-toggle>

<script>
	class ThemeToggle extends HTMLElement {
		constructor() {
			super();

			const button = this.querySelector('button')!;

			/** Set the theme to dark/light mode and save preference. */
			const setTheme = (dark: boolean) => {
				document.documentElement.classList[dark ? 'add' : 'remove']('theme-dark');
				button.setAttribute('aria-pressed', String(dark));
				// Save user preference to localStorage
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			};

			/** Sync button state to current theme without toggling or saving. */
			const syncButtonState = () => {
				button.setAttribute('aria-pressed', String(this.isDark()));
			};

			// Toggle the theme when a user clicks the button.
			button.addEventListener('click', () => setTheme(!this.isDark()));

			// Initialize button state to reflect current theme.
			syncButtonState();

			// Re-sync button state after View Transitions navigation.
			document.addEventListener('astro:page-load', syncButtonState);
		}

		isDark() {
			return document.documentElement.classList.contains('theme-dark');
		}
	}
	customElements.define('theme-toggle', ThemeToggle);
</script>
