---
import '../styles/global.css';
import { readerBootstrap } from '../lib/reader-prefs';
import { themeBootstrap } from '../lib/theme';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	image?: string | undefined;
}

const {
	title = 'Hello, my name is F Cary Snyder',
	description = 'Designer | Photographer | Cyclist',
	image = '/assets/social/social-card.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<meta charset="UTF-8" />
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<!-- Open Graph -->
<meta property="og:type" content="article" />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL.href} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.href} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL.href} />

<link rel="canonical" href={canonicalURL.href} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Mona Sans (GitHub, OFL): the site's sans for everything except metadata. Variable weight 400–700, with italics for prose. -->
<link
	href={import.meta.env.DEV
		? 'https://fonts.googleapis.com/css2?family=Mona+Sans:ital,wdth,wght@0,75..125,400..700;1,75..125,400..700&display=swap'
		: 'https://fonts.googleapis.com/css2?family=Mona+Sans:ital,wght@0,400..700;1,400..700&display=swap'}
	rel="stylesheet"
/>
<!-- (dev loads the width axis too, for the Swiss experiment's condensed titles) -->
<link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
<!-- Theme. Applied before paint, and to the incoming document before each View Transition swap:
     the server renders every page without .theme-dark and Astro copies the new <html> attributes,
     so theming only after the swap would flip the persisted toggle to light and back. -->
<script
	is:inline
	set:html={`(function(){var tb=(${themeBootstrap.toString()});tb();document.addEventListener('astro:before-swap',function(e){tb(e.newDocument)});document.addEventListener('astro:after-swap',function(){tb()})})();`}
/>
{import.meta.env.DEV && (
	<script is:inline>
		// Dev-only: Swiss experiment toggle state (components/dev/SwissToggle.astro), applied before
		// paint and to the incoming page before each swap so it doesn't flicker on navigation.
		(function () {
			var on = function () { try { return localStorage.getItem('dev-swiss') === '1'; } catch (e) { return false; } };
			var apply = function (d) { d.documentElement.classList.toggle('swiss', on()); };
			apply(document);
			document.addEventListener('astro:before-swap', function (e) { apply(e.newDocument); });
			document.addEventListener('astro:after-swap', function () { apply(document); });
		})();
	</script>
)}
<!-- Reader preferences (font, size, line spacing). Applied before paint, to the incoming document before each View Transition swap (so its head already carries the Literata link), and again after the swap as a safety net. -->
<script
	is:inline
	set:html={`(function(){var rb=(${readerBootstrap.toString()});rb();document.addEventListener('astro:before-swap',function(e){rb(e.newDocument)});document.addEventListener('astro:after-swap',function(){rb()})})();`}
/>
