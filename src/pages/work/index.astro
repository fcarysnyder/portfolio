---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Grid from '../../components/Grid.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';

const projects = (await getCollection('work'))
	.filter((project) =>
		project.data.title === 'Synthetic Readings - Performance Pages for ATLAS' ||
		project.data.title === 'Omniscience UI - Redesigning Manual Commanding' ||
		project.data.title === 'OpenNode Design System',
	)
	.sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Selected Work | F Cary Snyder" description="Selected work from F Cary Snyder's portfolio">
	<div class="flex flex-col gap-20">
		<main class="wrapper flex flex-col gap-6 lg:gap-8">
			<h1 class="t-page-title mb-3 max-w-[37ch]">Selected Work</h1>
			<Grid>
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
	</div>
</BaseLayout>
