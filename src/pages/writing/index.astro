---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { BookOpen } from '@lucide/astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

const sortedByDate = [...posts].sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const sortedByTitle = [...posts].sort(
	(a, b) => a.data.title.localeCompare(b.data.title)
);
---

<BaseLayout title="Writing | F Cary Snyder" description="Writing by F Cary Snyder">
	<main class="wrapper writing flex flex-col gap-6 lg:gap-8">
		<h1 class="t-page-title">Writing</h1>
		<SectionHeader label="All Posts">
			<BookOpen slot="icon" size={18} />
			<Fragment slot="filters">
				<a href="?sort=date" class="filter-option t-label" data-sort="date">Date</a>
				<span class="filter-dot" aria-hidden="true">&middot;</span>
				<a href="?sort=title" class="filter-option t-label" data-sort="title">Title (A-Z)</a>
			</Fragment>
		</SectionHeader>
		<ul class="post-list flex flex-col gap-4" data-list>
			{sortedByDate.map((post) => (
				<li class="flex items-baseline justify-between gap-4" data-title={post.data.title} data-date={post.data.publishDate.valueOf()}>
					<a href={`/writing/${post.id}/`} class="text-(length:--text-xl) font-normal text-gray-0 no-underline hover:text-accent-text-hover focus-visible:text-accent-text-hover">{post.data.title}</a>
					<time class="t-eyebrow whitespace-nowrap" datetime={post.data.publishDate.toISOString()}>
						{post.data.publishDate.toLocaleDateString('en-US', {
							month: 'long',
							day: 'numeric',
							year: 'numeric',
							timeZone: 'UTC',
						})}
					</time>
				</li>
			))}
		</ul>
	</main>
</BaseLayout>

<script>
	function applySort(sort: string) {
		// Highlight active sort option
		document.querySelectorAll('.filter-option').forEach((el) => {
			if (el instanceof HTMLAnchorElement) {
				el.classList.toggle('active', el.dataset.sort === sort);
			}
		});

		// Sort the list
		const list = document.querySelector('[data-list]');
		if (!list) return;

		const items = [...list.querySelectorAll('li')];
		items.sort((a, b) => {
			if (sort === 'title') {
				return (a.dataset.title || '').localeCompare(b.dataset.title || '');
			}
			return Number(b.dataset.date) - Number(a.dataset.date);
		});

		items.forEach((item) => list.appendChild(item));
	}

	function initSort() {
		const params = new URLSearchParams(window.location.search);
		applySort(params.get('sort') || 'date');

		document.querySelectorAll('.filter-option').forEach((el) => {
			el.addEventListener('click', (e) => {
				e.preventDefault();
				const sort = (el as HTMLAnchorElement).dataset.sort || 'date';
				history.replaceState(null, '', `?sort=${sort}`);
				applySort(sort);
			});
		});
	}

	initSort();
	document.addEventListener('astro:after-swap', initSort);
</script>
