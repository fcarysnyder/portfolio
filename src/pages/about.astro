---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from '../components/AboutHero.astro';
---

<BaseLayout title="About | F Cary Snyder" description="About F Cary Snyder">
	<div class="flex flex-col">
		<AboutHero
			title="About me"
			
		>
			<img
				class="about-img-1"
				src="/assets/about/img-1.jpg"
				alt="F Cary Snyder"
			/>
			<img
				class="about-img-2"
				src="/assets/about/img-2.jpg"
				alt="F Cary Snyder"
			/>
			<img
				class="about-img-3"
				src="/assets/about/img-3.jpg"
				alt="F Cary Snyder"
			/>
			<img
				class="about-img-4"
				src="/assets/about/img-4.jpg"
				alt="F Cary Snyder"
			/>
			<img
				class="about-img-5"
				src="/assets/about/img-5.jpg"
				alt="F Cary Snyder"
			/>
		</AboutHero>
		<main class="wrapper about flex flex-col gap-14 lg:grid lg:grid-cols-[1fr_60%_1fr]">
			<section class="flex flex-col gap-2 text-gray-200 lg:contents lg:text-(length:--text-xl)">
				<h2 class="section-title t-section-heading col-start-1">Background</h2>
				<div class="content col-[2/4] [&_p+p]:mt-[1.5em] [&_a]:underline [&_a]:decoration-1 [&_a]:decoration-transparent [&_a]:underline-offset-[0.25em] [&_a]:[transition:text-decoration-color_var(--theme-transition)] [&_a:hover]:decoration-current [&_a:focus]:decoration-current">
					<p>
						Seriously — my name is just the letter "F", but you can call me Cary.
					</p>
					<p>
						Born in San Francisco and raised in Oakland to an interior designer and a network engineer, I grew up at the intersection of art and technology. I started designing posters and customizing Myspace pages in middle school, unknowingly building the foundation for my future career.
					</p>
					<p>
						I currently call Santa Barbara home, having spent nearly a decade here.
					</p>
					<p>
						After college, a five-month trip through South America sparked my love for photography. Whether hiking the John Muir Trail, exploring Machu Picchu, or visiting the Colorado dunes, I'm rarely found without my camera.
					</p>
					<p>
						I'm also a passionate cyclist. I've completed multiple centuries and dream of riding from Stockholm to Oslo. My wife and I even honeymooned at a bike hotel in Lake Garda, Italy.
					</p>
				</div>
			</section>
			<section class="flex flex-col gap-2 text-gray-200 lg:contents lg:text-(length:--text-xl)">
				<h2 class="section-title t-section-heading col-start-1">Skills</h2>
				<div class="content col-[2/4] [&_p+p]:mt-[1.5em] [&_a]:underline [&_a]:decoration-1 [&_a]:decoration-transparent [&_a]:underline-offset-[0.25em] [&_a]:[transition:text-decoration-color_var(--theme-transition)] [&_a:hover]:decoration-current [&_a:focus]:decoration-current">
					<ul>
						<li>Product design</li>
						<li>UI/UX design</li>
						<li>Visual design</li>
						<li>Web design</li>
						<li>Email design</li>
						<li>AI web development / Cursor</li>
						<li>Competitive analysis</li>
						<li>Rapid prototyping</li>
						<li>Agile/scrum</li>
						<li>Frontend development</li>							
						<li>Copywriting</li>
					</ul>
				</div>
			</section>
			<section class="flex flex-col gap-2 text-gray-200 lg:contents lg:text-(length:--text-xl)">
				<h2 class="section-title t-section-heading col-start-1">Current Interests</h2>
				<div class="content col-[2/4] [&_p+p]:mt-[1.5em] [&_a]:underline [&_a]:decoration-1 [&_a]:decoration-transparent [&_a]:underline-offset-[0.25em] [&_a]:[transition:text-decoration-color_var(--theme-transition)] [&_a:hover]:decoration-current [&_a:focus]:decoration-current">
					<ul>
						<li>Building with Claude and Cursor</li>
						<li>Three.js</li>
						<li>CSS-driven UI componeents a la <a href="https://www.daisyui.com">DaisyUI</a>.</li>
						<li>Drawing</li>
						<li>Calisthenics</li>
						<li>Logo design</li>
					</ul>
				</div>
			</section>
		</main>
	</div>
</BaseLayout>

<style>
	/* Why not Tailwind: each emoji cursor is a data-URI SVG whose markup contains quotes, angle
	   brackets and an emoji. As an arbitrary utility value it would need heavy escaping and be
	   unreadable, so the five hover cursors stay as plain CSS. */
	:global(.about-img-1:hover) {
		cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewport="0 0 100 100" style="fill:black;font-size:24px;"><text y="50%">👋</text></svg>'),
			auto;
	}

	:global(.about-img-2:hover) {
		cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewport="0 0 100 100" style="fill:black;font-size:24px;"><text y="50%">🐣</text></svg>'),
			auto;
	}

	:global(.about-img-3:hover) {
		cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewport="0 0 100 100" style="fill:black;font-size:24px;"><text y="50%">🇮🇹</text></svg>'),
			auto;
	}

	:global(.about-img-4:hover) {
		cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewport="0 0 100 100" style="fill:black;font-size:24px;"><text y="50%">🚲</text></svg>'),
			auto;
	}

	:global(.about-img-5:hover) {
		cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewport="0 0 100 100" style="fill:black;font-size:24px;"><text y="50%">🕺</text></svg>'),
			auto;
	}
</style>
