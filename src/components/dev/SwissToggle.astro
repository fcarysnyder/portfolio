---
// Dev-only switch for the Swiss experiment (src/styles/swiss.css). BaseLayout only renders this in
// `npm run dev`; MainHead applies the saved state before paint and before each page swap.
---

<swiss-toggle data-dev-only>
	<button type="button" class="swiss-toggle fixed bottom-4 left-4 z-[10001] cursor-pointer border border-gray-800 bg-gray-999 px-3 py-[0.4rem] font-mono text-(length:--text-xs) leading-none font-medium tracking-[0.06em] text-gray-300 uppercase aria-pressed:border-accent-fill aria-pressed:bg-accent-fill aria-pressed:text-on-accent" aria-pressed="false">Swiss</button>
</swiss-toggle>

<script>
	class SwissToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button')!;
			const sync = () => button.setAttribute('aria-pressed', String(document.documentElement.classList.contains('swiss')));
			button.addEventListener('click', () => {
				const on = !document.documentElement.classList.contains('swiss');
				document.documentElement.classList.toggle('swiss', on);
				try {
					localStorage.setItem('dev-swiss', on ? '1' : '0');
				} catch {
					// Storage blocked: the toggle still works for this page view.
				}
				sync();
			});
			sync();
			document.addEventListener('astro:page-load', sync);
		}
	}
	if (!customElements.get('swiss-toggle')) customElements.define('swiss-toggle', SwissToggle);
</script>
