---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const sorted = posts.sort(
		(a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf()
	);

	return sorted.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			prevPost: sorted[index - 1] ?? null,
			nextPost: sorted[index + 1] ?? null,
		},
	}));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

const firstImageMatch = post.body?.match(/!\[.*?\]\(([^)]+)\)/);
const socialImage = firstImageMatch ? firstImageMatch[1] : undefined;

const readingTime = getReadingTime(post.body ?? '');
---

<BaseLayout title={`${post.data.title} | F Cary Snyder`} description={post.data.description} image={socialImage}>
	<main class="wrapper post-layout">
		<article data-reader-enabled>
			<PageHeader
				title={post.data.title}
				description={post.data.description}
				date={post.data.publishDate}
				readingTime={readingTime}
				backHref="/writing/"
			/>

			<div class="post-content prose">
				<Content />
			</div>

			<footer class="post-footer">
				{post.data.tags && post.data.tags.length > 0 && (
					<div class="post-meta t-meta">
						<div class="meta-row">
							<span class="meta-label">Tags</span>
							<span class="meta-value">{post.data.tags.join(', ')}</span>
						</div>
					</div>
				)}

				<nav class="post-nav">
					<div class="nav-prev">
						{prevPost && (
							<a href={`/writing/${prevPost.id}/`} class="t-small-link">&larr; Previous</a>
						)}
					</div>
					<div class="nav-next">
						{nextPost && (
							<a href={`/writing/${nextPost.id}/`} class="t-small-link">Next &rarr;</a>
						)}
					</div>
				</nav>
			</footer>
		</article>
	</main>
</BaseLayout>

<style>
	.post-layout {
		display: flex;
		flex-direction: column;
	}

	article {
		width: 100%;
	}

	/* Article body styles live in .prose (src/styles/prose.css) */
	.post-content {
		margin-top: 3rem;
	}

	.post-content :global(.react-tweet-theme) {
		margin: 2rem auto;
	}

	/* Bottom-of-post meta: Tags only (the date is in the header) */
	.post-footer {
		margin-top: 4rem;
	}

	.post-meta {
		border-top: 1px solid var(--gray-800);
		padding-top: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.meta-row {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.meta-label {
		color: var(--gray-400);
		text-transform: uppercase;
		min-width: 4rem;
	}

	.meta-value {
		color: var(--gray-200);
	}

	/* Prev / Next navigation */
	.post-nav {
		display: flex;
		justify-content: space-between;
		margin-top: 2rem;
		padding: 1.5rem 0;
		border-top: 1px solid var(--gray-800);
	}

	.nav-prev,
	.nav-next {
		display: flex;
	}

	.nav-next {
		margin-left: auto;
	}

	/* Desktop: center column like about page */
	@media (min-width: 60em) {
		.post-layout {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		article {
			grid-column: 2;
		}
	}
</style>
