---
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { PenTool } from '@lucide/astro';

import { getCollection } from 'astro:content';

// Content Fetching: List five most recent work projects
const projects = (await getCollection('work'))
	.filter((project) =>
		project.data.title === 'Synthetic Readings - Performance Pages for ATLAS' ||
		project.data.title === 'Omniscience UI - Redesigning Manual Commanding' ||
		project.data.title === 'OpenNode Design System',
	)
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const title = "Hi, I'm F Cary Snyder";
---

<BaseLayout title={title} useIntroAnimation={true}>
	<div class="flex flex-1 flex-col justify-center gap-20">
		<div class="relative w-full max-w-full">
			<header class="wrapper flex w-full flex-col items-start gap-4 lg:grid lg:grid-cols-[1fr_3fr] lg:items-center lg:gap-8">
				<img
					alt="Headshot of F Cary Snyder"
					width="480"
					height="620"
					src="/assets/headshot.jpg"
					class="headshot h-[320px] w-[240px] rounded-[20px] object-cover object-top max-lg:hidden lg:aspect-[3/4] lg:h-auto lg:max-h-[70vh] lg:w-[300px] lg:min-w-[300px]"
				/>
				<Hero align="start" title="Hi, I'm F Cary Snyder">
					<Fragment slot="tagline">
						I'm a Staff UX Designer who codes. Currently designing next-generation industrial control software that improves energy savings at <a href="https://crossnokaye.com" class="company-link">CrossnoKaye</a>. Previously built design systems and satellite constellation C3 interfaces. I love solving complex problems at the intersection of design and engineering.
					</Fragment>
				</Hero>
			</header>
		</div>

		<main class="wrapper flex flex-col gap-20 lg:gap-48">
			<section class="grid w-full grid-cols-1 gap-8 [grid-template-areas:'header'_'gallery'] lg:grid-cols-4 lg:[grid-template-areas:'header_header_header_header'_'gallery_gallery_gallery_gallery']">
				<div class="w-full [grid-area:header]">
					<SectionHeader label="Selected Projects">
						<PenTool slot="icon" size={18} color="var(--gray-200)" />
					</SectionHeader>
				</div>
				<div class="[grid-area:gallery]">
					<Grid >
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>
			</section>
		</main>
	</div>
</BaseLayout>
