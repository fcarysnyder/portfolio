---
interface Props {
	label: string;
	filterId?: string;
}

const { label, filterId } = Astro.props;
const hasFilters = Astro.slots.has('filters');
---

<div class="section-header w-full text-(length:--text-xl)">
	<div class="header-content flex h-[38px] w-full items-center gap-2 border-b border-gray-200 pb-2 text-gray-200 [&>svg]:shrink-0">
		<slot name="icon" />
		<h3 class="text-(length:--text-sm) text-gray-200 uppercase">{label}</h3>
		{hasFilters && (
			<div class="filter-options flex items-center gap-2 ml-auto [&_.filter-dot]:text-gray-400 [&_.filter-option]:cursor-pointer [&_.filter-option]:border-none [&_.filter-option]:bg-transparent [&_.filter-option]:p-0 [&_.filter-option]:font-sans [&_.filter-option]:text-(length:--text-sm) [&_.filter-option]:text-gray-400 [&_.filter-option]:uppercase [&_.filter-option]:no-underline [&_.filter-option]:[transition:color_var(--theme-transition)] [&_.filter-option.active]:text-accent-text [&_.filter-option:focus-visible]:text-accent-text-hover [&_.filter-option:hover]:text-accent-text-hover" id={filterId}>
				<slot name="filters" />
			</div>
		)}
	</div>
</div>
