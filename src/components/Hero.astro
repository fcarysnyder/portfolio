---
import { ArrowRight } from '@lucide/astro';

interface Props {
	title?: string;
	align?: 'start' | 'center';
	button?: boolean;
}

const { align = 'center', title, button = true } = Astro.props;

// Complete class strings, so Tailwind can see them.
const alignClasses = {
	start: { root: 'text-start lg:self-center', child: '' },
	center: { root: 'text-center', child: 'mx-auto' },
};
const { root: alignRoot, child: alignChild } = alignClasses[align];
---

<div class:list={['hero flex w-full flex-col gap-2 text-(length:--text-xl) lg:text-(length:--text-2xl)', alignRoot]}>
	<div class="flex flex-col gap-2">
		{title && <h1 class:list={['title t-display mb-3 max-w-[37ch]', alignChild]}>
			<slot name="title">{title}</slot>
		</h1>}
		{Astro.slots.has('tagline') && <p class:list={['tagline t-lead w-full [&_.company-link]:text-accent-text [&_.company-link]:underline [&_.company-link]:decoration-1 [&_.company-link]:decoration-transparent [&_.company-link]:underline-offset-[0.2em] [&_.company-link]:[transition:color_var(--theme-transition),text-decoration-color_var(--theme-transition)] [&_.company-link:hover]:text-accent-text-hover [&_.company-link:hover]:decoration-current [&_.company-link:focus-visible]:text-accent-text-hover [&_.company-link:focus-visible]:decoration-current', alignChild]}>
			<slot name="tagline" />
		</p>}
		<slot />
		{button && <a href="mailto:fcarysnyder@gmail.com?subject=Saw%20your%20website!" class="button mt-5 inline-flex h-10 w-fit cursor-pointer items-center justify-center gap-2 rounded-lg border-none bg-accent-fill px-4 text-sm/5 font-semibold text-on-accent uppercase no-underline hover:bg-accent-fill-hover">Drop me a line <ArrowRight size="1em" /></a>}
	</div>
</div>
